# Copy to .env.production and fill in every value before deploying.
# Generate secrets: openssl rand -base64 32

# Public site (must match DNS A record pointing at your VPS)
DOMAIN=wordle.example.com
ACME_EMAIL=you@example.com

# Postgres (not exposed publicly; used only inside Docker)
POSTGRES_PASSWORD=change-me-long-random-db-password

# API auth
JWT_SECRET=change-me-long-random-jwt-secret
ADMIN_PASSWORD=change-me-long-admin-passphrase

# Must match https://DOMAIN (no trailing slash)
CORS_ORIGIN=https://wordle.example.com
FRONTEND_URL=https://wordle.example.com

# Max rows in the admin approval queue (pending only)
MAX_PENDING_REGISTRATIONS=100
