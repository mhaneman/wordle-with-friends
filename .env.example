# Copy to .env at repo root: cp .env.example .env

DATABASE_URL=postgres://wordle:wordle@db:5432/wordle?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Invite-only: set a strong password for the admin dashboard
ADMIN_PASSWORD=change-me-admin-password

# Local dev API URL (leave empty in production — same-origin via Caddy)
VITE_API_URL=http://localhost:8080

# Production-only (see .env.production.example):
# APP_ENV=production
# COOKIE_SECURE=true
# TRUST_PROXY=true
